[Desktop Entry]
Version=1.0
Type=Application
Name=Xportify
GenericName=Music Downloader
Comment=Convierte tus listas de Spotify, YouTube Music y más a MP3
Exec=bash -c 'DIR="$(dirname "$(readlink -f "%k")")"; cd "$DIR"; ./Xportify'
Icon=xportify.png
Terminal=false
Categories=AudioVideo;Audio;Utility;
StartupNotify=true
StartupWMClass=Xportify
MimeType=audio/mpeg;
